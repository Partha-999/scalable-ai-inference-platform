{
  "title": "AI Inference Platform",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(ai_platform_requests_total[5m])) by (route)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Inference Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(ai_platform_inference_latency_seconds_bucket[5m])) by (le, model_id))", "refId": "B"}]
    },
    {
      "type": "timeseries",
      "title": "Ray Replica Count",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(ray_serve_deployment_replica_count) by (deployment)", "refId": "C"}]
    },
    {
      "type": "timeseries",
      "title": "Ray Queue Depth",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum(ray_serve_deployment_queued_queries) by (deployment)", "refId": "D"}]
    },
    {
      "type": "timeseries",
      "title": "Ray Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum(rate(ray_serve_deployment_request_counter_total[5m])) by (deployment)", "refId": "E"}]
    },
    {
      "type": "timeseries",
      "title": "Ray Processing Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(ray_serve_deployment_processing_latency_ms_bucket[5m])) by (le, deployment))", "refId": "F"}]
    }
  ]
}
